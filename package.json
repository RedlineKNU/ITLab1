{
  "name": "mini-drive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/desktop",
    "packages/web"
  ],
  "scripts": {
    "test": "vitest run",
    "test:server": "vitest run -r packages/server",
    "test:shared": "vitest run -r packages/shared",
    "test:desktop": "vitest run -r packages/desktop",
    "test:web": "vitest run -r packages/web",
    "dev:server": "npm run dev --workspace=@mini-drive/server",
    "dev:desktop": "npm run dev --workspace=@mini-drive/desktop",
    "dev:web": "npm run dev --workspace=@mini-drive/web",
    "build:web": "npm run build --workspace=@mini-drive/web",
    "seed": "npm run seed --workspace=@mini-drive/server"
  },
  "devDependencies": {
    "vitest": "^2.1.2"
  }
}
